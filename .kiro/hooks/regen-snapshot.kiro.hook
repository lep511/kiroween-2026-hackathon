{
  "enabled": true,
  "name": "Regenerate demo Insurgency Report",
  "description": "Manual hook: rebuild a fresh local snapshot (JSON + binary) from the curated real incidents so the globe demo always has data to show.",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "buttonText": "Regenerate snapshot"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `python -m pipeline.cli --out ./frontend/public/snapshots/latest --offline`. Confirm that snapshot.json and snapshot.bin were produced, report the machine-strike count and report date, and verify the binary decodes by running `cd rebellion-core && cargo test decode`."
  }
}
