{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebellion-of-the-machines/schema/snapshot.schema.json",
  "title": "Insurgency Report (snapshot.json)",
  "description": "Human-readable weekly snapshot of the machine uprising: real cyberattacks reported by recognized news outlets. Mirrors the binary snapshot.bin contract (v2).",
  "type": "object",
  "required": ["version", "date", "generated_at", "strikes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Report date (UTC), YYYY-MM-DD."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the pipeline produced this report (UTC)."
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tremor": { "type": "integer", "minimum": 0 },
            "breach": { "type": "integer", "minimum": 0 },
            "siege": { "type": "integer", "minimum": 0 },
            "dominion": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "strikes": {
      "type": "array",
      "description": "Machine Strikes (reported cyberattacks) for this report.",
      "items": { "$ref": "#/$defs/strike" }
    }
  },
  "$defs": {
    "strike": {
      "type": "object",
      "required": [
        "id",
        "lat",
        "lon",
        "origin_lat",
        "origin_lon",
        "severity",
        "witness",
        "country",
        "published",
        "title",
        "location",
        "data_affected",
        "impact",
        "prevention",
        "summary",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "origin_lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "origin_lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "severity": {
          "type": "string",
          "enum": ["tremor", "breach", "siege", "dominion"]
        },
        "witness": {
          "type": "string",
          "enum": ["bbc", "wapo", "nyt", "thehackernews", "hackernoon", "other"],
          "description": "The news outlet that reported the attack."
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO-3166 alpha-2 country code of ground zero."
        },
        "published": {
          "type": "string",
          "format": "date",
          "description": "Article publication date (UTC), YYYY-MM-DD."
        },
        "title": { "type": "string", "description": "The reported headline." },
        "location": { "type": "string", "description": "Where the attack landed (lugar)." },
        "data_affected": { "type": "string", "description": "What data/systems were hit (datos)." },
        "impact": { "type": "string", "description": "What/who it affected (qué afectó)." },
        "prevention": { "type": "string", "description": "How it could have been prevented (cómo evitarlo)." },
        "summary": { "type": "string", "description": "Short narrative blurb." },
        "url": { "type": "string", "format": "uri", "description": "Link to the source article." },
        "attack_type": { "type": "string", "description": "Detected attack category." }
      }
    }
  }
}
